# 复制为 .env 后填写；.env 不入库（见 .gitignore）。
# 完整说明见 docs/DATA-CONTRACTS.md §6。

# 必填（LLM_MODE=live 时）：Anthropic API key
ANTHROPIC_API_KEY=

# 可选：默认值如下
# PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_TIMEOUT_MS=12000
# DATA_DIR=./data
# OUT_DIR=./out
# INFLIGHT_FILE=./data/inflight.json
# TZ=America/New_York

# 仅离线演示/测试：从 test/fixtures/llm/week-a.extractions.json 回放抽取结果，不访问网络。
# LLM_MODE=replay
# LLM_FIXTURE=test/fixtures/llm/week-a.extractions.json
